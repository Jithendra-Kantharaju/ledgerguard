# Copy to .env. Everything here has a working default for local development.

# Postgres: the app connects as ap_app (non-owner, so row-level security applies).
DATABASE_URL=postgresql://ap_app:ap_app@localhost:5432/apagent
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apagent

# Storage: local (files under .storage/) or s3 (MinIO / AWS).
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Extraction. "rules" works offline with no key. For real invoices use an LLM:
#   EXTRACTOR=anthropic            (model from ANTHROPIC_MODEL)
#   EXTRACTOR=anthropic:claude-sonnet-5-5
#   SECONDARY_EXTRACTOR=anthropic:claude-haiku-5-5   (second, independent pass for agreement)
EXTRACTOR=rules
SECONDARY_EXTRACTOR=rules_alt
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# OCR for scanned PDFs: none | tesseract (needs the tesseract binary and `pip install -e ".[ocr]"`)
OCR_BACKEND=none

# Mock AP system used by the outbox dispatcher.
AP_API_URL=http://localhost:8001
AP_API_TOKEN=dev-ap-token

# Tracing to Langfuse (OTLP). Leave empty to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(public_key:secret_key)>
# TRACE_CONSOLE=true

CORS_ORIGINS=http://localhost:5173

# Shadow mode: make every decision but send nothing to AP (first weeks at a customer).
SHADOW_MODE=false
